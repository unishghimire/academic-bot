# Database Configuration (PostgreSQL Neon or Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/academy_db?schema=public"

# Discord Bot Credentials
DISCORD_TOKEN="your_bot_token_here"
DISCORD_CLIENT_ID="your_client_id_here"
DISCORD_GUILD_ID="your_guild_id_here"

# Discord Role IDs (managed by bot, hoisted)
ROLE_PREMIUM="100000000000000001"
ROLE_TIER_1="100000000000000002"
ROLE_TIER_2="100000000000000003"
ROLE_TIER_3="100000000000000004"
ROLE_GRADUATE="100000000000000005"
ROLE_INSTRUCTOR="100000000000000006"
ROLE_ADMIN="100000000000000007"

# Discord Channel IDs
CHANNEL_WELCOME="200000000000000001"
CHANNEL_RULES="200000000000000002"
CHANNEL_ANNOUNCEMENTS="200000000000000003"
CHANNEL_LEADERBOARD="200000000000000004"
CHANNEL_SHOWCASE="200000000000000005"
CHANNEL_SUPPORT="200000000000000006"
CHANNEL_ERROR_LOGS="200000000000000007"
CHANNEL_AUDIT_LOGS="200000000000000008"

# Backend & Webhook Server
PORT=3000
ACADEMY_API_SECRET="CHANGE_ME_generate_a_strong_shared_secret"
ACADEMY_WEBSITE_URL="https://academy.example.com"
ADMIN_PANEL_KEY="CHANGE_ME_generate_a_strong_random_key_min_16_chars"

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# AI Assistant
AI_DAILY_CAP_PER_USER=20
AI_MONTHLY_BUDGET_KILL_SWITCH=500
OPENAI_API_KEY="sk-proj-xxx"
